# Task runner for pay CLI

# Build release binary
build:
    cargo build --release

# Run all tests
test:
    cargo test --workspace

# Run unit tests only
unit-test:
    cargo test --workspace --exclude pay-integration

# Run integration tests only
integration-test:
    cargo test -p pay-integration

# Clippy (warnings = errors)
lint:
    cargo clippy --workspace --all-targets -- -D warnings

# Format check
fmt:
    cargo fmt --check

# Format + lint
check: fmt lint

# Run a workspace binary, forwarding subcommands.
# Examples:
#   just run pay whoami
#   just run pay accounts
#   just run pay account new ludo
run BIN *ARGS:
    cargo run -p {{BIN}} -- {{ARGS}}

# Build Docker image
docker-build:
    DOCKER_BUILDKIT=1 docker build --ssh default -t pay .

# Run Docker image (pass args after --)
docker-run *ARGS:
    docker run --rm pay {{ARGS}}

# Build the pay-api service image.
docker-build-pay-api:
    docker build -f crates/pay-api/Dockerfile -t pay-api .

# Build the pay-worker (close-channels, settle-sessions) service image.
docker-build-pay-worker:
    docker build -f crates/pay-worker/Dockerfile -t pay-worker .

# ── pay-worker operator jobs ────────────────────────────────────────────────
#
# Dry-run (default, SAFE — logs the plan, signs/sends NOTHING):
#   CHANNEL_ADDRESSES=<b58,b58,...> just close-channels
#
# Real run (BROADCASTS — requires an explicit DRY_RUN=false):
#   DRY_RUN=false CHANNEL_ADDRESSES=<b58,...> just close-channels
#
# The fee payer comes from PAY_API_SEND__FEE_PAYER__KEY_NAME / __PUBKEY
# (GCP KMS) or LOCAL_FEE_PAYER_PRIVATE_KEY. Prefer running under Doppler:
#   doppler run -- just close-channels
close-channels:
    cargo run --release -p pay-worker --bin close-channels

# Preview durable session + x402 batch lifecycle reconciliation (DRY_RUN defaults true).
settle-sessions:
    cargo run --release -p pay-worker --bin settle-sessions

# Gate an API with a paywall
gate-api PAYWALL *ARGS:
    cargo run -- gate api {{PAYWALL}} {{ARGS}}

# Backward-compatible alias for local scripts.
serve PAYWALL *ARGS:
    cargo run -- gate api {{PAYWALL}} {{ARGS}}

# Start the payment verifier service (for Apigee / external gateways)
apigee-serve *ARGS:
    cargo run -p pay -- server verify {{ARGS}}
