# Copy this file to proxy.env, fill every value, and keep it out of git.
PAY_PAYMENT_RECIPIENT=REPLACE_WITH_SOLANA_RECIPIENT
# RPC is used to open channels and for the five-minute settlement sweep. Paid
# requests verify their cumulative vouchers locally and do not call this RPC.
PAY_RPC_URL=https://REPLACE_WITH_PRIVATE_SOLANA_RPC
# Solana CLI JSON array or base58-encoded 64-byte operator keypair. The operator
# sponsors channel transactions and signs settlement batches.
PAY_OPERATOR_KEYPAIR=REPLACE_WITH_OPERATOR_KEYPAIR
# Generate once with: openssl rand -hex 32
PAY_SESSION_SECRET=REPLACE_WITH_64_HEX_CHARACTERS
