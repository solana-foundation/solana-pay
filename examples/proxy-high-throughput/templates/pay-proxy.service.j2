[Unit]
Description=High-throughput Pay MPP proxy
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User={{ pay_service_user }}
Group={{ pay_service_user }}
WorkingDirectory={{ pay_source_dir }}/rust
EnvironmentFile={{ pay_config_dir }}/proxy.env
Environment=RUST_LOG=info,pay_core=warn,hyper=warn,reqwest=warn,tower=warn
ExecStart={{ pay_install_dir }}/pay server start {{ pay_config_dir }}/paywall.yml --bind {{ pay_proxy_bind }} --no-register
Restart=on-failure
RestartSec=2
LimitNOFILE={{ pay_proxy_nofile }}
TasksMax=infinity
CPUAccounting=true
MemoryAccounting=true
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/{{ pay_service_user }}

[Install]
WantedBy=multi-user.target
